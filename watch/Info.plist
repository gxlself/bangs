<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Bangs answers on the local network over plain HTTP (see
       src-tauri/src/remote.rs); everything else stays under ATS. -->
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsLocalNetworking</key>
    <true/>
  </dict>
  <!-- Asked for once, where watchOS asks at all, before the first request
       reaches the computer. The Chinese is in zh-Hans.lproj/InfoPlist.strings. -->
  <key>NSLocalNetworkUsageDescription</key>
  <string>Bangs connects to Bangs on your Mac over the local network.</string>
  <!-- The app speaks Chinese and English (Text.swift); saying so here makes
       the system's own words follow. -->
  <key>CFBundleLocalizations</key>
  <array>
    <string>en</string>
    <string>zh-Hans</string>
  </array>
</dict>
</plist>
