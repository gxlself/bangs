        { "kind": "todo", "id": "1", "updatedAt": 9, "device": "phone", "deleted": false, "body": { "text": "old", "createdAt": 1 }, "asset": null }
      ],
      "applied": [],
      "versionsAfter": [ { "key": "todo:1", "updatedAt": 10, "device": "mac", "deleted": false } ]
    },
    {
      "name": "a newer version wins",
      "versions": [ { "key": "todo:1", "updatedAt": 10, "device": "mac", "deleted": false } ],
