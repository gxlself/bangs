{
  "_doc": "Conformance vectors for docs/sync.md. Rust (src-tauri/src/sync/ledger.rs) and Swift (packages/BangsCloud/Tests) both run these.",

  "compare": [
    { "name": "newer updatedAt wins whatever the device", "a": { "updatedAt": 2, "device": "a" }, "b": { "updatedAt": 1, "device": "z" }, "aWins": true },
    { "name": "older updatedAt loses", "a": { "updatedAt": 1, "device": "z" }, "b": { "updatedAt": 2, "device": "a" }, "aWins": false },
    { "name": "equal time: larger device wins", "a": { "updatedAt": 1, "device": "b" }, "b": { "updatedAt": 1, "device": "a" }, "aWins": true },
    { "name": "equal time: smaller device loses", "a": { "updatedAt": 1, "device": "a" }, "b": { "updatedAt": 1, "device": "b" }, "aWins": false },
    { "name": "identical versions: neither wins", "a": { "updatedAt": 1, "device": "a" }, "b": { "updatedAt": 1, "device": "a" }, "aWins": false }
  ],

  "nextStamp": [
    { "name": "first version takes the clock", "prev": null, "now": 100, "stamp": 100 },
    { "name": "clock behind the previous version: still goes forward", "prev": 100, "now": 90, "stamp": 101 },
    { "name": "clock equal to the previous version: goes forward", "prev": 100, "now": 100, "stamp": 101 },
    { "name": "clock ahead: takes the clock", "prev": 100, "now": 200, "stamp": 200 }
  ],

  "applyRemote": [
    {
      "name": "an unknown key is adopted",
      "versions": [],
      "incoming": [
        { "kind": "todo", "id": "1", "updatedAt": 5, "device": "a", "deleted": false, "body": { "text": "x", "createdAt": 5 }, "asset": null }
      ],
      "applied": ["todo:1"],
      "versionsAfter": [
        { "key": "todo:1", "updatedAt": 5, "device": "a", "deleted": false }
      ]
    },
    {
      "name": "an older version is ignored",
