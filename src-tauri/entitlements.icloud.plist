<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Release (Developer ID), with iCloud sync: used instead of entitlements.plist
       when building with tauri.icloud.conf.json. These have to match the
       Developer ID provisioning profile embedded in the app (src-tauri/icloud/);
       without the profile macOS refuses to launch an app that claims them. -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>
  <key>com.apple.application-identifier</key>
  <string>W8L8ZJ3N2P.com.gxlself.bangs</string>
  <key>com.apple.developer.team-identifier</key>
  <string>W8L8ZJ3N2P</string>
  <key>com.apple.developer.icloud-container-identifiers</key>
  <array>
    <string>iCloud.com.gxlself.bangs</string>
  </array>
  <key>com.apple.developer.icloud-services</key>
  <array>
    <string>CloudKit</string>
  </array>
  <!-- Which CloudKit database: a Developer ID app has to name it (Xcode adds
       this on a Developer ID export); the iPhone app on TestFlight or the App
       Store is on Production, the one run from Xcode on Development. -->
  <key>com.apple.developer.icloud-container-environment</key>
  <string>Production</string>
  <key>com.apple.developer.aps-environment</key>
  <string>production</string>
</dict>
</plist>
